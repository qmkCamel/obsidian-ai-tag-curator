{
  "name": "obsidian-ai-tag-curator",
  "version": "0.1.2",
  "description": "AI tag management and governance plugin for Obsidian vaults.",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "local:install": "npm run build && node scripts/install-local.mjs",
    "local:install-dev": "npm run build && node scripts/install-local.mjs --dev",
    "spec:list": "openspec list",
    "spec:status": "openspec status",
    "spec:validate": "openspec validate",
    "test": "vitest run",
    "test:unit": "vitest run tests/*.test.ts",
    "test:e2e": "vitest run tests/e2e"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "tags",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmkCamel/obsidian-ai-tag-curator.git"
  },
  "bugs": {
    "url": "https://github.com/qmkCamel/obsidian-ai-tag-curator/issues"
  },
  "homepage": "https://github.com/qmkCamel/obsidian-ai-tag-curator#readme",
  "author": "qmkCamel",
  "license": "MIT",
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "@types/node": "^20.12.7",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.1",
    "jsdom": "^24.1.3",
    "obsidian": "^1.5.12",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
